---
// カテゴリに属する記事だけを抽出してページ分割するルート。
import { getCollection } from "astro:content";
import BaseHead from "../../../components/BaseHead.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Posts from "../../../components/Posts.astro";
import GoogleResponsiveAd from "../../../components/GoogleResponsiveAd";
import Pagination from "../../../components/Pagination.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../../config";

export async function getStaticPaths({ paginate }: any) {
  // カテゴリごとに記事を絞り込み、それぞれ独立した一覧ページを生成する。
  const categories = (await getCollection("categories")).map((entry) => ({
    ...entry.data,
    id: entry.id,
  }));
  const allTags = categories.map((category) => category.id);
  const posts = (await getCollection("blogs"))
    .map((entry) => ({
      ...entry.data,
      id: entry.id,
    }))
    .sort(
      (a, b) =>
        new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime(),
    );

  return allTags.flatMap((categoryId) => {
    const filteredPosts = posts.filter(
      (post) =>
        post.categories &&
        post.categories.map((category) => category.id).includes(categoryId),
    );
    return paginate(filteredPosts, {
      params: { categoryId },
      pageSize: 10,
    });
  });
}
const { page } = Astro.props;
const params = Astro.params;
const category = (await getCollection("categories")).find(
  (entry) => entry.id === params.categoryId,
);
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead
      title={`${category?.data.name ?? "Category"}|${SITE_TITLE}`}
      description={SITE_DESCRIPTION}
    />
    <style>
      ul {
        list-style-type: none;
        padding: unset;
      }
      ul li {
        display: flex;
      }
      ul li time {
        flex: 0 0 130px;
        font-style: italic;
        color: #595959;
      }
      ul li a:visited {
        color: #8e32dc;
      }

      div a div {
        margin: 1em auto;
      }
      div a div time {
        flex: 0 0 130px;
        font-style: italic;
        color: #595959;
      }
      div a:visited {
        color: #8e32dc;
      }

      div a div h2 {
        margin-top: 0;
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="main">
      <Sidebar />
      <section class="contents">
        <h1>{category?.data.name ?? "Category"}</h1>
        <Posts posts={page.data} />
        <Pagination page={page} categoryId={params.categoryId} />
        <GoogleResponsiveAd client:only="preact" />
      </section>
    </main>
    <Footer />
  </body>
</html>
