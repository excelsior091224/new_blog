---
// microCMSで管理している外部アカウントへのリンク一覧。
import { getCollection } from "astro:content";
import HeaderLink from "./HeaderLink.astro";

const accounts = (await getCollection("accounts"))
  .map((entry) => ({
    ...entry.data,
    id: entry.id,
  }))
  .sort(
    (a, b) => new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime(),
  );
---

<ul>
  {
    accounts.map((account: any) => (
      <li>
        <HeaderLink
          href={account.url}
          target="_blank"
          rel="noopener noreferrer me"
        >
          {account.title}
        </HeaderLink>
      </li>
    ))
  }
  <li>
    <a
      rel="noopener sponsored"
      href="https://dlaf.jp/home/dlaf/=/aid/Gimlet20231006/url/https%3A%2F%2Fwww.dlsite.com%2Fhome%2Fcircle%2Fprofile%2F%3D%2Fmaker_id%2FRG01076933.html%2F%3Futm_medium%3Daffiliate%26utm_campaign%3Dbnlink%26utm_content%3Dtext"
      target="_blank">DLsiteサークルページ</a
    >
  </li>
</ul>
